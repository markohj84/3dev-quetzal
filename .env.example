ANTHROPIC_API_KEY=
CALENDLY_URL=https://calendly.com/

# Notificación de leads — mismo proveedor que usa el formulario de 3dev.mx
RESEND_API_KEY=

# Sesiones — integración de Upstash Redis desde Vercel Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Configurar en: https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp — solo cuando el canal se habilite
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App secret de Meta, para validar la firma X-Hub-Signature-256 del webhook
WHATSAPP_APP_SECRET=

# Calendly — webhook de reservas (Settings → Integrations → Webhooks)
# Sin esta llave la ruta /api/calendly rechaza todo: queda inerte, no rota.
CALENDLY_WEBHOOK_SIGNING_KEY=

# Calendly — Personal Access Token, para leer disponibilidad real.
# Sin él el asistente solo entrega el link, sin proponer horarios.
CALENDLY_API_TOKEN=
