# ── Plataforma: las comparte todo el deploy ───────────────────────────────

ANTHROPIC_API_KEY=

# Sesión de 24 h y límites de mensajes. Integración de Upstash Redis del Marketplace de Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Postgres (Supabase): conversaciones, leads, fichas, uso. El esquema está en supabase/migrations/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# El panel y la administración leen con la sesión de quien entra, nunca con service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La app de Meta es de la plataforma: una firma y un token de verificación para todos sus números.
# Sin WHATSAPP_APP_SECRET el webhook rechaza todo. En local sirve cualquier valor.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Vercel firma con esto el cron del seguimiento. Sin él, /api/cron/follow-up responde 403.
CRON_SECRET=

# Un deploy para todos los clientes: cada petición se resuelve por dominio o por número.
# Sin esta variable, un proyecto es de un cliente y CLIENT elige su carpeta de clients/.
# MULTI_TENANT=1
# CLIENT=3dev

# A quién avisar cuando el asistente no puede contestar. Sin ella, el aviso sale
# por los canales del cliente que falló. Ponerla antes del primer cliente externo.
# ALERT_EMAIL=

# ── Del cliente ───────────────────────────────────────────────────────────
# Con MULTI_TENANT=1 llevan el id del cliente como prefijo y no tienen respaldo
# sin él: QUETZAL_3DEV__CALCOM_API_KEY (id en mayúsculas; lo no alfanumérico, "_").

# Agenda dentro del chat. Sin llave, el asistente solo comparte el enlace.
CALCOM_API_KEY=

# Aviso de cada prospecto por correo. El dominio del remitente debe estar verificado en Resend.
RESEND_API_KEY=

# El número del asistente y su token (usuario del sistema, sin vencimiento).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Solo lo usa scripts/client-check.ts, para revisar y crear las plantillas.
WHATSAPP_WABA_ID=

# El mismo aviso por WhatsApp, al número personal del dueño (52 + 10 dígitos).
# No ponerla en .env.local: cada eval que capture un lead mandaría un WhatsApp real.
# NOTIFY_WHATSAPP_TO=

# Cada aviso como POST a un flujo (n8n). La URL es secreta; con el secreto, va firmado.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=

# Solo si el cliente usa Calendly en lugar de Cal.com.
# CALENDLY_API_TOKEN=
# CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Solo para scripts locales ─────────────────────────────────────────────

# Números que `npm run report:3dev` no cuenta (el del dueño), separados por coma.
# REPORT_EXCLUDE=
